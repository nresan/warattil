<?xml version="1.0" encoding="utf-8"?>
<!--
  WARATTIL V3 — الورد اليومي menu glyph.

  An open Mushaf — two pages joined at a center spine, a ribbon bookmark
  falling from the spine.  No rihal stand.

  Design history:
   • v1 (2026-04-27): Mushaf cradled in an X-shaped wooden rihal.  The X
     read as a music-notation stand to multiple users (Nasser feedback);
     the rihal silhouette dominated the glyph at 22dp and obscured the
     book itself.
   • v2 (2026-04-27, pt. 2): Stand removed.  Just the open Mushaf with
     a ribbon bookmark — closer to Nasser's first reference image (an
     open codex without stand).  More space for the page silhouette,
     no possibility of the music-stand misread.

  All shapes drawn as outline so Icon(tint = theme.gold) paints the
  whole composition uniformly across cream / dark / sepia themes.
  Same drawing register as ic_lawh_dawaah_qalam, so the dropdown menu
  reads as one matched kuttāb-aesthetic set.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Center spine of the Mushaf.  A double line — the inner one is
         the binding fold, the slight curve at top + bottom suggests
         a printed Mushaf's rounded spine. -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,4.5 L12,19.5" />

    <!-- Left page: top edge curves slightly as if the page is laid open
         under its own weight, outer edge straight, bottom edge mirrors
         the top.  Inner edge meets the spine at the same Y as the right
         page so the open-book silhouette reads as symmetric. -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,4.5 C9.5,5 6.5,5.2 3,5.2 L3,18.8 C6.5,18.8 9.5,19 12,19.5" />

    <!-- Right page — mirror of the left -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,4.5 C14.5,5 17.5,5.2 21,5.2 L21,18.8 C17.5,18.8 14.5,19 12,19.5" />

    <!-- Page text lines — three short marks per page, give the icon
         the visual texture of a typeset Mushaf rather than blank
         pages.  Right-aligned on the left page, left-aligned on the
         right page so they read as marginal text columns. -->
    <!-- Left page lines -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5,8.5 L10.5,8.3" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5,11 L10.5,10.8" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5,13.5 L10.5,13.3" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5,16 L10.5,15.8" />

    <!-- Right page lines -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M13.5,8.3 L19,8.5" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M13.5,10.8 L19,11" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M13.5,13.3 L19,13.5" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M13.5,15.8 L19,16" />

    <!-- Ribbon bookmark — falls from the spine through the bottom of
         the Mushaf.  Reinforces the "active reading" semantic; without
         it the open Mushaf could read as "any open book." -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,19.5 L12,22" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,22 L11,21.2" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,22 L13,21.2" />
</vector>
