# ─────────────────────────────────────────────────────────────────────────────
# WARATTIL V3 — release signing template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `keystore.properties` (in the same folder as build.gradle.kts
# at the repo root), fill in the four values for your machine, and DO NOT commit
# the resulting file.  The .gitignore already excludes `keystore.properties` and
# any `*.jks` keystore.
#
# storeFile = absolute path to warattil_new_upload.jks (the Play upload key).
#             Keep the .jks OUTSIDE the repo — typically ~/keystores/.
#             Verify its SHA-1 matches the value Play Console expects:
#                 keytool -list -v -keystore "$storeFile" -alias upload | grep SHA1
#             Last known good SHA-1: 75:50:B1:91:…
#
# storePassword / keyPassword = passwords set when the keystore was generated.
#             Often identical; keep both correct or signing fails with
#             "keystore was tampered with, or password was incorrect".
#
# keyAlias  = `upload`  (the alias inside the .jks Nasser registered with Play).
# ─────────────────────────────────────────────────────────────────────────────

storeFile     = /Users/yourname/keystores/warattil_new_upload.jks
storePassword = REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias      = upload
keyPassword   = REPLACE_WITH_KEY_PASSWORD
